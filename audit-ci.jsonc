{
  // Fail CI on HIGH and CRITICAL severity advisories.
  "high": true,

  // Audit PRODUCTION dependencies only. Vinyl Vault is a client-side static app:
  // the build tooling (vite, esbuild, @babel, ...) lives in devDependencies and never
  // ships in the deployed bundle. Dev-tooling advisories are surfaced instead by
  // Dependabot alerts/PRs, so they don't fail this workflow every week.
  "skip-dev": true,

  // Advisories explicitly acknowledged and accepted. Currently none: xlsx was
  // upgraded to SheetJS 0.20.3 (official CDN build), which fixes CVE-2023-30533
  // (prototype pollution) and CVE-2024-22363 (ReDoS). Add an entry here only with a
  // comment explaining why it is accepted and how it will be resolved.
  "allowlist": []
}
